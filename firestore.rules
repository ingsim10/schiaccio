rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Ognuno legge e scrive solo il proprio profilo.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // L'amministratore (Simone) legge e corregge tutti i profili.
      allow read, update: if request.auth != null
        && request.auth.token.email == "simone.frattaioli@gmail.com";
    }
  }
}
